# ==============================================================================
# M.A.T.E. Environment Configuration Template (Placeholders only)
# ==============================================================================

# Node / API Service
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://mate_user:mate_password@localhost:5432/mate_db
POSTGRES_USER=mate_user
POSTGRES_PASSWORD=mate_password
POSTGRES_DB=mate_db
POSTGRES_PORT=5432

# Redis Cache & Queues (Optional in dev)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=your_dev_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_dev_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# S3 / MinIO Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=mate-media-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# Image Processing Service (Python FastAPI)
IMAGE_SERVICE_URL=http://localhost:8000
IMAGE_SERVICE_PORT=8000

# Client Web
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME="M.A.T.E. - Meeting Adventure Travel Escape"
